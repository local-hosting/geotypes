{
  "name": "@twinfile/geotypes",
  "version": "0.1.2",
  "packageManager": "yarn@4.9.2",
  "description": "Open POI taxonomy registry (YAML / proto) and runtime slugs for Twinfile place units",
  "license": "MPL-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/twinfile/geotypes.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./generated/geospatial": {
      "types": "./generated/geospatial_pb.d.ts",
      "import": "./generated/geospatial_pb.js",
      "default": "./generated/geospatial_pb.js"
    },
    "./generated/tags": {
      "types": "./generated/tags_pb.d.ts",
      "import": "./generated/tags_pb.js",
      "default": "./generated/tags_pb.js"
    },
    "./geokit": {
      "types": "./dist/geokit-adapter.d.ts",
      "import": "./dist/geokit-adapter.js",
      "default": "./dist/geokit-adapter.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "yarn build",
    "generate": "tsx cli/proto.ts generate",
    "proto": "tsx cli/proto.ts",
    "category": "tsx cli/category.ts",
    "test-short-ids": "tsx cli/proto.ts test-short-ids",
    "sync:slugs": "tsx scripts/sync-slugs.ts",
    "sync:acronyms": "tsx scripts/sync-acronyms.ts",
    "sync:providers": "tsx scripts/sync-provider-categories.ts",
    "sync:format-mappings": "tsx scripts/sync-format-mappings.ts",
    "sync:place-archetypes": "tsx scripts/sync-place-archetypes.ts",
    "sync": "yarn sync:slugs && yarn sync:acronyms && yarn sync:providers && yarn sync:format-mappings && yarn sync:place-archetypes",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "node scripts/check-vendor-neutral.mjs && yarn build && yarn typecheck && yarn test",
    "viz": "vite --config viz/vite.config.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.6.0",
    "js-yaml": "^4.1.0"
  },
  "files": [
    "dist",
    "generated",
    "data",
    "README.md"
  ],
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.1",
    "@westlane/isocanvas": "portal:../../westlane/isocanvas",
    "axios": "^1.12.2",
    "commander": "^14.0.0",
    "nanoid": "^5.1.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
